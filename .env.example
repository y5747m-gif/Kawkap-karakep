# ==== رابط التطبيق (للاستخدام في الروابط المطلقة ومنصة Supabase) ====
VITE_APP_URL=https://kawkap-karakep.vercel.app

# ==== Supabase (اختياري الآن — يلزم عند الانتقال للمصادقة الحقيقية على الخادم) ====
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# ==== بوابة مالك الموقع (نسخة العرض فقط) ====
# تحذير أمني: قيم VITE_* تُدمج في ملفات الجافاسكربت المرسلة للمتصفح.
# غيّرها قبل النشر، وفي الإنتاج الفعلي يجب أن تتم مصادقة المالك على خادم
# (Supabase Auth أو Edge Function) وليس من متغيرات بيئة في الواجهة.
VITE_OWNER_USERNAME=owner
VITE_OWNER_PASSWORD=Kawkap@2026
